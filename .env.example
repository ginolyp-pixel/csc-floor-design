NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Where SQLite + uploaded photos + composed previews live. Keep this
# OUTSIDE the git working tree so deploys never touch user data.
DATA_DIR=/var/lib/csc-designer

# Days before a saved design auto-purges.
DESIGN_TTL_DAYS=90

# Upload size guards (bytes).
MAX_PHOTO_BYTES=15728640
MAX_PREVIEW_BYTES=10485760
